<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.anesop</groupId>
    <artifactId>m5</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>m5-impl</artifactId>
  <name>ANESOP :: M5 实时态势与 KPI 看板 IMPL</name>
  <description>M5 实时态势与 KPI 看板 实现（只读聚合/数据范围/审计采样）；只允许依赖本模块 api，不得依赖其他模块 impl</description>

  <dependencies>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m5-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- 看板口径阈值用 @ConfigurationProperties（anesop.m5.dashboard.*）绑定 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <!-- 越权语义（AccessDeniedException），由 Web 层统一映射 403 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>

    <!-- 单测：JUnit 5 + AssertJ + Mockito（版本由 Spring Boot BOM 管理） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
