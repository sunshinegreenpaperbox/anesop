<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.anesop</groupId>
    <artifactId>m2</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>m2-impl</artifactId>
  <name>ANESOP :: M2 麻醉信息管理 IMPL</name>
  <description>M2 麻醉信息管理 实现与数据访问；只允许依赖本模块 api，不得依赖其他模块 impl</description>

  <dependencies>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m2-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- T-4 收口：麻精判定只调 m4-api 的药品字典服务（不访问 m4 表与 mapper） -->
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m4-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 术前访视复用 M1 申请/患者可见性（同步只调 m1-api，不访问 m1 表与 mapper） -->
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m1-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- M2-M4-01 S-1：评分切点/量表版本用 @ConfigurationProperties（anesop.m2.preop.*）绑定 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <!-- 事务边界（创建/更新/最终化 + 审计同事务） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <!-- 越权语义（AccessDeniedException），由 Web 层统一映射 403 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>
    <!-- 持久层：MyBatis-Plus（版本由根 pom dependencyManagement 锁定） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <!-- 评分输入/结果 jsonb 结构化序列化（allowlist 已登记 jackson-databind） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- 单测：JUnit 5 + AssertJ + Mockito（版本由 Spring Boot BOM 管理） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
