<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.anesop</groupId>
    <artifactId>anesop-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>api-bootstrap</artifactId>
  <name>ANESOP :: API Bootstrap</name>
  <description>
    唯一可执行装配点：Web/Actuator/OpenAPI 基础设施 + 各模块 API，
    S0-07 起叠加 M0 认证权限运行时（Security、JWT、MyBatis、Flyway、审计）。
  </description>

  <dependencies>
    <!-- 模块 API：bootstrap 只面向各模块契约装配 -->
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m0-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m1-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m2-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m3-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m4-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m5-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m6-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m7-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m8-api</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- M0 认证与权限运行时（S0-07）：bootstrap 是唯一允许依赖 impl 的装配点 -->
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m0-impl</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- M1 手术申请实现（M2-M1-01）：bootstrap 是唯一允许依赖 impl 的装配点 -->
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m1-impl</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- M4 药品目录与麻精五专实现（M4-M15-01）：bootstrap 是唯一允许依赖 impl 的装配点 -->
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m4-impl</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- M2 术前访视实现（M2-M4-01）：bootstrap 是唯一允许依赖 impl 的装配点 -->
    <dependency>
      <groupId>com.anesop</groupId>
      <artifactId>m2-impl</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- 基础设施 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!-- 认证与权限（S0-07）：JWT 资源服务器（Nimbus）、方法级 RBAC、审计 AOP -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- 数据源 + Flyway 运行时（m0-impl 提供 flyway-core/pg 方言，本模块提供 JDBC 池） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 集成测试用嵌入式 PostgreSQL 16（Docker 不可用，EXT-08），版本由根 pom 锁定 -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers（S0-11）：Docker 不可用（EXT-08）期间只编译、默认不执行；
      测试类标 @Tag("docker")，surefire 默认 excludedGroups=docker，-Pdocker 反向激活。
      版本由根 pom 的 testcontainers-bom 1.20.4 锁定。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      数据库迁移脚本进入 classpath：production locations = classpath:db/migration；
      dev/test profile 额外追加 classpath:db/seed/demo（仅演示账号，prod 不加载）。
      由 maven-resources-plugin 在 process-resources 阶段复制。
    -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../../../db/migration</directory>
        <targetPath>db/migration</targetPath>
      </resource>
      <resource>
        <directory>${project.basedir}/../../../db/seed/demo</directory>
        <targetPath>db/seed/demo</targetPath>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        S0-11：API 侧聚合覆盖率报告（HTML/XML）。
        api-bootstrap 依赖全部模块 api 与 m0-impl，report-aggregate 会把各依赖模块的
        jacoco.exec 与本模块执行数据合并，便于查看“跨模块集成测试”后的真实覆盖率
        （m0-impl 的业务类主要由本模块集成测试覆盖）。
        输出：target/site/jacoco-aggregate/。逐模块 check 门禁仍由根 pom 执行。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
