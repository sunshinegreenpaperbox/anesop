{
  "name": "@anesop/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "ANESOP OpenAPI 3.1 契约、Spectral 规则与 TypeScript 类型生成（契约优先的唯一事实源）",
  "license": "UNLICENSED",
  "type": "commonjs",
  "types": "./generated/typescript/auth.d.ts",
  "exports": {
    "./auth": {
      "types": "./generated/typescript/auth.d.ts"
    },
    "./patient": {
      "types": "./generated/typescript/patient.d.ts"
    },
    "./scheduling": {
      "types": "./generated/typescript/scheduling.d.ts"
    },
    "./anesthesia": {
      "types": "./generated/typescript/anesthesia.d.ts"
    },
    "./device": {
      "types": "./generated/typescript/device.d.ts"
    },
    "./drug": {
      "types": "./generated/typescript/drug.d.ts"
    },
    "./staff": {
      "types": "./generated/typescript/staff.d.ts"
    },
    "./material": {
      "types": "./generated/typescript/material.d.ts"
    },
    "./report": {
      "types": "./generated/typescript/report.d.ts"
    },
    "./qc": {
      "types": "./generated/typescript/qc.d.ts"
    },
    "./dashboard": {
      "types": "./generated/typescript/dashboard.d.ts"
    }
  },
  "scripts": {
    "lint": "spectral lint --fail-severity=warn --ruleset .spectral.yaml openapi/auth.yaml openapi/patient.yaml openapi/scheduling.yaml openapi/anesthesia.yaml openapi/device.yaml openapi/drug.yaml openapi/staff.yaml openapi/material.yaml openapi/report.yaml openapi/qc.yaml openapi/dashboard.yaml",
    "gen:ts": "bash ../../scripts/gen-contracts.sh",
    "check:breaking": "bash ../../scripts/contract-check.sh --breaking-only"
  },
  "devDependencies": {
    "@oasdiff-js/oasdiff-js": "1.0.0",
    "@stoplight/spectral-cli": "6.16.0",
    "openapi-typescript": "7.13.0"
  }
}
