# =============================================================================
# ANESOP Compose 环境变量示例
#
# 用法：
#   cp deploy/compose/.env.example deploy/compose/.env
#   修改所有 CHANGE_ME 值后再启动；.env 已被 .gitignore 忽略，严禁入库。
#
# 本文件只放占位符，不含任何真实密钥/IP/证书；生产值由院方信息科在部署机上填写，
# 并纳入口令管理系统（建议后续切 Docker secrets / Vault，见 docs/deploy/README.md）。
# =============================================================================

# --- 基础 ---
TZ=Asia/Shanghai

# --- PostgreSQL 16 ---
POSTGRES_USER=anesop
# CHANGE_ME：≥16 位，含大小写/数字/符号；不得与其它系统复用
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=anesop

# --- Redis 7.2 ---
# CHANGE_ME：≥16 位；Redis 仅内网可达，仍须设口令（§3.9.1）
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- RabbitMQ 3.13 ---
RABBITMQ_DEFAULT_USER=anesop
RABBITMQ_DEFAULT_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# --- MinIO ---
MINIO_ROOT_USER=anesop-minio
# CHANGE_ME：≥16 位；MinIO 要求 ≥8 位
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# --- 应用镜像 tag（发布时改为 <版本>-<构建号> 或 git sha；严禁 latest）---
ANESOP_API_TAG=1.0.0
ANESOP_WEB_TAG=1.0.0

# --- API ---
SPRING_PROFILES_ACTIVE=prod
SPRING_FLYWAY_LOCATIONS=filesystem:/opt/anesop/db/migration
# JWT 签名密钥（必填）：Base64 编码，解码后 ≥32 字节；每院独立，轮换须走发布流程。
# 生成方式：openssl rand -base64 48
# 留空/占位值/低熵值都会导致启动失败（安全默认 fail-closed），不要填 CHANGE_ME 一类示例值。
ANESOP_JWT_SECRET=

# 手机号等敏感字段 AES-256-GCM 密钥（必填）：Base64，解码后**恰好 32 字节**。
# 生成方式：openssl rand -base64 32
# 留空/占位值/低熵/长度不符都会拒绝启动（fail-closed）；丢失将导致手机号密文永久不可解密。
ANESOP_FIELD_KEY=
# 字段密钥版本标识（≤32 字符），写入 sys_user.phone_key_id；轮换时递增，默认 v1。
ANESOP_FIELD_KEY_ID=v1

# 手机号 HMAC pepper（必填）：Base64，解码后 ≥32 字节；与字段密钥分别生成且不得相同。
# 生成方式：openssl rand -base64 48
ANESOP_PHONE_PEPPER=

# M1 住院号匹配 pepper（必填）：Base64，解码后 ≥32 字节；与手机号 pepper 分离、不得复用。
# 生成方式：openssl rand -base64 48
# 留空/非法 Base64/长度不足都会导致启动失败（fail-closed）；丢失将无法再匹配历史住院号哈希。
ANESOP_INPATIENT_PEPPER=

# 采集网关内部令牌（可选但生产采集必需）：与用户 JWT 分离；未配置时 ingest 一律 401（fail-closed）。
# 生成方式：openssl rand -base64 32；只注入 api 与采集网关，不进入浏览器。
ANESOP_M2_ACQUISITION_GATEWAY_TOKEN=

# --- 监控（profile: monitoring；仅绑 127.0.0.1）---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
# CHANGE_ME：Grafana 管理员口令，≥16 位
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
