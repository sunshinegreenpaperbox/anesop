# =============================================================================
# ANESOP 本地开发环境变量示例（dev）
#
# 用法（仓库根）：
#   cp .env.example .env          # .env 已被 .gitignore 忽略，禁止入库
#   set -a; source .env; set +a   # 当前脚本/应用不自动读取 .env，必须显式导出
#
# 与 deploy/compose/.env.example 的关系：
#   - 本文件 = 开发者本机 dev：连 127.0.0.1 的 PG，SPRING_PROFILES_ACTIVE=dev，
#     允许演示账号与进程内随机 JWT 密钥，仅用于合成数据；
#   - deploy/compose/.env.example = 单院生产 Compose：profile=prod，密钥必须
#     CHANGE_ME 后由院方填写，Flyway 只挂 db/migration（不含演示种子）；
#   - 两者不共用：不要把生产值抄进本文件，也不要把本文件的 dev 值部署到生产。
#
# 红线：本文件与 .env 不得出现真实患者数据、真实姓名/工号/手机号、生产密钥。
# =============================================================================

# ---------------------------------------------------------------------------
# 应用 profile（必填）
#   dev  = 本机开发：springdoc 开启、Flyway 追加 db/seed/demo、允许 demo_* 账号；
#   test = 自动化测试（由测试基类注入数据源，不需要本文件）；
#   prod = 生产：关闭文档、只加载 db/migration、缺失 JWT 密钥即拒绝启动。
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# PostgreSQL 16（dev 必填；决定后端能否启动、seed-demo.sh 能否初始化）
#   application.yml 的默认值 = jdbc:postgresql://127.0.0.1:5432/anesop
#   若使用非默认端口/库名，必须显式设置 ANESOP_DB_URL。
# ---------------------------------------------------------------------------
ANESOP_DB_URL=jdbc:postgresql://127.0.0.1:5432/anesop
ANESOP_DB_USER=anesop
# 仅本机 dev 的默认口令；不要与任何生产/院方系统复用
ANESOP_DB_PASSWORD=anesop
# 可选：连接池上限（默认 10）；本地 PG 较小时可降到 5
ANESOP_DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# JWT 签名密钥（dev 可留空；prod 必填）
#   - 要求：Base64 编码，解码后 ≥32 字节；每院独立，轮换走发布流程；
#   - dev：留空时 application-dev.yml 的 allow-dev-generated=true 会生成
#     进程内随机密钥，重启后旧访问/刷新令牌失效（需重新登录）；
#   - prod：留空、占位值或低熵值都会导致启动失败（安全默认 fail-closed）；
#   - 生成：openssl rand -base64 48
#   - 禁止把生成结果写进本文件、工单、日志或截图。
# ---------------------------------------------------------------------------
ANESOP_JWT_SECRET=

# ---------------------------------------------------------------------------
# 前端（可选）
#   VITE_API_BASE_URL 留空 = 前端请求 /api，由 Vite dev proxy 转发到
#   http://localhost:8080 并去掉 /api 前缀（见 apps/web/vite.config.ts）；
#   生产由 Nginx 把 /api 反代到 API，前端代码不变。
#   仅当需要前端直连后端时才设置（例如 http://localhost:8080，需自行解决跨域）。
#   注意：Vite 只读取 apps/web 下的 .env* 文件或进程环境变量；写在仓库根 .env
#   后必须先 `set -a; source .env; set +a` 再执行 pnpm 命令。
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# 设备采集网关（可选；S0-09 POC，独立进程，默认 8081 / TCP 19090）
#   不启动网关时这些变量都不需要。数据库默认与上面 API 指向同一个库。
# ---------------------------------------------------------------------------
ANESOP_GATEWAY_DB_URL=jdbc:postgresql://127.0.0.1:5432/anesop
ANESOP_GATEWAY_DB_USER=anesop
ANESOP_GATEWAY_DB_PASSWORD=anesop
# 网关本地缓冲目录（断网缓存 ≥4 小时；运行时会创建，切勿提交到仓库）
ANESOP_GATEWAY_BUFFER_DIR=./data/buffer
# SYNTHETIC 模拟设备数据（仅 dev/demo，禁止生产置 true）
ANESOP_GATEWAY_SYNTHETIC=true
# 其余网关参数（TCP 端口、缓冲大小、上传间隔等）见
# services/device-gateway/src/main/resources/application.yml 的 ANESOP_GATEWAY_* 默认值。

# ---------------------------------------------------------------------------
# 其他可选开关
# ---------------------------------------------------------------------------
# API 端口（Spring Boot；默认 8080）
# SERVER_PORT=8080
# 本地无 Docker 时跳过 compose-check 的运行时探测（EXT-08；静态校验仍执行）
# ANESOP_SKIP_DOCKER_RUNTIME_CHECK=1
