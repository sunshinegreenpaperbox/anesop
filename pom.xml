<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    ANESOP 父 POM（S0-02）。
    继承 spring-boot-starter-parent 以获得 Boot 依赖管理与插件基线；
    所有第三方版本在此统一锁定，子模块不得自写版本（见 AGENTS.md「技术栈锁定」）。
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.anesop</groupId>
  <artifactId>anesop-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ANESOP :: Parent</name>
  <description>ANESOP 麻醉信息平台父 POM：版本锁定与构建基线</description>

  <modules>
    <module>apps/api</module>
    <module>services/device-gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 持久层与数据库迁移 -->
    <mybatis-plus.version>3.5.9</mybatis-plus.version>
    <flyway.version>10.20.1</flyway.version>
    <h2.version>2.3.232</h2.version>
    <!-- PostgreSQL JDBC 驱动版本由 Spring Boot BOM 管理，不在此覆盖 -->

    <!-- 接口文档：springdoc-openapi-bom:2.7.0 未在 Maven Central 发布，
         故锁定 starter 2.7.0（与 Boot 3.4.x 对齐），由本文件 dependencyManagement 统一版本 -->
    <springdoc.version>2.7.0</springdoc.version>

    <!-- 测试与架构校验 -->
    <archunit.version>1.3.0</archunit.version>
    <testcontainers.version>1.20.4</testcontainers.version>

    <!-- 契约 → Java DTO 生成（S0-07；版本集中管理，模块不得自写） -->
    <openapi-generator.version>7.10.0</openapi-generator.version>

    <!-- 嵌入式 PostgreSQL（Docker 不可用 EXT-08 时的集成测试基座；S0-06 起使用） -->
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <embedded-postgres-binaries.version>16.15.0</embedded-postgres-binaries.version>

    <!-- 集成组件：本阶段只锁版本属性，依赖在 S0-09 采集网关任务中引入 -->
    <camel.version>4.14.0</camel.version>
    <hapi.version>2.5.1</hapi.version>

    <!-- 静态检查（S0-03）：Checkstyle 在 validate 阶段、SpotBugs 在 verify 阶段 -->
    <checkstyle.version>10.26.1</checkstyle.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <spotbugs-maven-plugin.version>4.9.8.5</spotbugs-maven-plugin.version>

    <!-- 测试覆盖率（S0-11）：JaCoCo prepare-agent + report + check（verify 阶段） -->
    <jacoco.version>0.8.12</jacoco.version>
    <!--
      覆盖率阈值默认值（整体）：AGENTS.md「编码与测试要求」整体行 ≥70%、分支 ≥55%。
      核心域（m0 权限审计 / m2 / device-gateway）由下方按模块目录激活的 profile
      覆盖为 80%/70%，见 <profiles> 中 coverage-core-* 的说明。
    -->
    <jacoco.line.min>0.70</jacoco.line.min>
    <jacoco.branch.min>0.55</jacoco.branch.min>

    <!--
      仓库根目录：由 scripts/mvn.sh 注入 -Danesop.root=<repo root>。
      直接执行 mvn 时回退到 Maven 的多模块根（从仓库根调用即为仓库根）。
      规则文件统一放在 <repo root>/config/{checkstyle,spotbugs}/。
    -->
    <anesop.root>${maven.multiModuleProjectDirectory}</anesop.root>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Testcontainers BOM（1.20.4；覆盖 Boot 3.4.5 默认的 1.20.6，见 CONTRACT 说明） -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- MyBatis-Plus：Spring Boot 3 专用 starter -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>

      <!-- Flyway：核心 + PostgreSQL 方言（Boot BOM 亦管理，此处显式锁定同一版本） -->
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-core</artifactId>
        <version>${flyway.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-database-postgresql</artifactId>
        <version>${flyway.version}</version>
      </dependency>

      <!-- springdoc-openapi（starter 2.7.0，对齐 Boot 3.4.x） -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>

      <!-- ArchUnit：模块边界用例 -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>

      <!--
        嵌入式 PostgreSQL（Zonky）：无需 Docker 即可用真实 PostgreSQL 16 跑 Flyway 与集成测试。
        许可证：embedded-postgres Apache-2.0；PostgreSQL 二进制为 PostgreSQL License（均在白名单）。
        精确二进制版本由 BOM 统一覆盖（避免走 2.2.2 默认的 PG 14）。
      -->
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>${embedded-postgres.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- 可执行 JAR 只在 api-bootstrap 激活；其余模块不打包成 boot jar -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <!-- 契约 → Java DTO（apps/api/api-contracts 使用，版本在此统一） -->
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        Surefire（S0-11）：默认排除 @Tag("docker") 的 Testcontainers 用例。
        Docker 当前不可用（EXT-08），这些用例写而不跑；恢复后用 -Pdocker 反向激活
        （profile 设置 groups=docker 并覆盖 excludedGroups）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>docker</excludedGroups>
        </configuration>
      </plugin>

      <!--
        JaCoCo（S0-11）：prepare-agent 注入 argLine，report 生成 target/site/jacoco，
        check 在 verify 阶段执行覆盖率门禁。阈值：
        - 整体：LINE ≥ ${jacoco.line.min}（0.70）、BRANCH ≥ ${jacoco.branch.min}（0.55）
        - 核心域：由 <profiles> 的 coverage-core-* 按模块目录激活，覆盖为 0.80/0.70
        排除项只含数据载体/生成物/装配配置，不排除 service 或领域逻辑，清单见 docs/testing/README.md。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <!-- 实体/DTO：MyBatis-Plus 实体只有字段与 getter/setter -->
            <exclude>**/persistence/entity/**</exclude>
            <!-- Mapper 接口：无逻辑，SQL 行为由集成测试验证 -->
            <exclude>**/persistence/mapper/**</exclude>
            <!-- Spring Boot 启动类 -->
            <exclude>**/*Application.class</exclude>
            <!-- 装配配置：Bean 声明，业务行为在 service 中验证 -->
            <exclude>**/config/**</exclude>
            <!-- 构建期生成物（契约 DTO 等）：禁止手改，故不纳入人工覆盖率目标 -->
            <exclude>**/generated/**</exclude>
            <exclude>**/contracts/**/model/**</exclude>
            <exclude>**/package-info.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Checkstyle：validate 阶段执行，违规即失败。
        - 规则文件 config/checkstyle/checkstyle.xml（Google 风格放宽：4 空格、行宽 160、不强制 Javadoc）
        - 只检查 src/main/java；测试源码不纳入
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <!-- 覆盖插件自带 9.3，使用支持 Java 21 语法的新版 Checkstyle -->
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${anesop.root}/config/checkstyle/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>error</violationSeverity>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
          <inputEncoding>UTF-8</inputEncoding>
          <outputEncoding>UTF-8</outputEncoding>
          <linkXRef>false</linkXRef>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        SpotBugs：verify 阶段执行（effort=Max、threshold=Medium），
        排除清单 config/spotbugs/exclude.xml 只含占位骨架噪声，不含真实缺陷豁免。
      -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-maven-plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <!--
            固定 fork 进程堆上限：S0-03 记录过偶发 "Java returned: 1"（并发构建/内存压力）。
            1024m 足以跑 Max effort 全量分析，同时避免默认值在容器/CI 小内存下被 OOM 杀掉；
            不降低 effort/threshold，检测强度不变。
          -->
          <maxHeap>2048</maxHeap>
          <!-- 注：spotbugs-maven-plugin 4.x 的堆参数名是 maxHeap（默认 512MB）；
               api-contracts 生成类增多后 512MB 会 OOM 退出（Java returned: 1）。 -->
          <excludeFilterFile>${anesop.root}/config/spotbugs/exclude.xml</excludeFilterFile>
          <includeTests>false</includeTests>
          <xmlOutput>true</xmlOutput>
          <failOnError>true</failOnError>
          <spotbugsXmlOutputDirectory>${project.build.directory}/spotbugs</spotbugsXmlOutputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-verify</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      核心域覆盖率阈值（AGENTS.md：核心域行 ≥80%、分支 ≥70%）。
      这些 profile 以“模块 basedir 下是否存在该文件”激活，因此只会对目标模块生效，
      不需要修改各核心模块的 pom（S0-11 写域限制）。新增模块时按同样方式登记。
      M2-M0-03（2026-11-13）已补齐 m0-impl 单测，实测 96.34%/87.52%，
      临时 ratchet 与 expires 标记全部删除，恢复 AGENTS 门槛。
    -->
    <profile>
      <id>coverage-core-m0</id>
      <activation>
        <file>
          <exists>src/main/java/com/anesop/m0/impl/auth/AuthServiceImpl.java</exists>
        </file>
      </activation>
      <properties>
        <!-- 实测（2026-11-13，仅本模块单测）：LINE 96.34%、BRANCH 87.52%。 -->
        <jacoco.line.min>0.80</jacoco.line.min>
        <jacoco.branch.min>0.70</jacoco.branch.min>
      </properties>
    </profile>

    <profile>
      <id>coverage-core-m1</id>
      <activation>
        <file>
          <exists>src/main/java/com/anesop/m1/impl/application/SurgeryApplicationServiceImpl.java</exists>
        </file>
      </activation>
      <properties>
        <!-- 核心域 m1（手术申请接收）：按 m1-impl basedir 文件存在激活，80/70 与 AGENTS 一致。 -->
        <jacoco.line.min>0.80</jacoco.line.min>
        <jacoco.branch.min>0.70</jacoco.branch.min>
      </properties>
    </profile>

    <profile>
      <id>coverage-core-m2</id>
      <activation>
        <file>
          <exists>src/main/java/com/anesop/m2/impl/package-info.java</exists>
        </file>
      </activation>
      <properties>
        <jacoco.line.min>0.80</jacoco.line.min>
        <jacoco.branch.min>0.70</jacoco.branch.min>
      </properties>
    </profile>

    <profile>
      <id>coverage-core-gateway</id>
      <activation>
        <file>
          <exists>src/main/java/com/anesop/gateway/DeviceGatewayApplication.java</exists>
        </file>
      </activation>
      <properties>
        <!-- 实测（2026-11-13）：LINE 91.68%、BRANCH 77.39%（LocalBuffer/TcpDeviceServer
             异常分支与模拟设备用例已补齐）。 -->
        <jacoco.line.min>0.80</jacoco.line.min>
        <jacoco.branch.min>0.70</jacoco.branch.min>
      </properties>
    </profile>

    <!--
      反向激活 @Tag("docker") 的 Testcontainers 用例：mvn -Pdocker verify。
      Docker 不可用时 @Testcontainers(disabledWithoutDocker=true) 会自动 skip。
    -->
    <profile>
      <id>docker</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>docker</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
